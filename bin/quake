  echo $class

  #if [ $class = "kitty" ]; then
    #wmctrl -ia $(cat ~/.local/state/lastfocusedwindow)
  #else
    echo $ACTIVE_WINDOW > ~/.local/state/lastfocusedwindow
    #wmctrl -xa kitty.kitty || kitty
  #fi
  kitty -c ~/.config/kitty/kitty.conf -c ~/.config/kitty/quick_access_terminal.conf
}

