declare -a git_opts=()
declare -a cmd=()
declare -a cmd_opts=()
declare -a tail=()

local git_opts_regex="^(--no-pager)"
local args_later_regex="^(stash)"
local opts_regex="^-"
local needs_arg=false
local accepting_args=false
## Loop through the args and reorder them as necessary
for i in "${@}"
do
  if [[ "$i" =~ "$git_opts_regex" ]]; then
    git_opts+=( "$i" )
    continue
  fi
  if [[ $accepting_args = "true" ]]; then
    if [[ $needs_arg = "true" ]]; then
      cmd_opts+=( "$i" )
      needs_arg=false
      continue
    fi
    if [[ "$i" =~ "$opts_regex" ]]; then
      cmd_opts+=( "$i" )
      needs_arg=true
      continue
    fi
  fi
  if [ ${#cmd[@]} -eq 0 ]; then
    cmd+=( "$i" )
    if [[ "$i" =~ "$args_later_regex" ]]; then
      accepting_args=false
    fi
    continue
  fi
  tail+=( "$i" )
done
declare -a shell=()
shell+=( "${cmd[@]}" )
shell+=( "${cmd_opts[@]}" )
shell+=( "${tail[@]}" )
# echo "$GIT_BIN ${shell[@]}" > /dev/stderr
$GIT_BIN ${shell[@]}
