  "cli_default_open_behavior": "existing_window",
  "icon_theme": {
    "mode": "dark",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "buffer_font_family": "MesloLGS NF",
  "ui_font_family": ".ZedSans",
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "title_bar": {

  },
  "project_panel": {
    "dock": "left",
    "git_status_indicator": true
  },
  "toolbar": {
    "code_actions": true,
    "selections_menu": true,
    "quick_actions": true
  },
  "minimap": {
    "show": "never"
  },
  "tabs": {
    "show_close_button": "hidden",
    "activate_on_close": "left_neighbour"
  },
  "agent_servers": {

  },
  "show_edit_predictions": true,
  "use_autoclose": false,
  "edit_predictions": {
    "provider": "ollama",
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
  },
  "vim_mode": true,
  "ui_font_size": 14.0,
  "buffer_font_size": 11.0,
  "terminal": {
    "font_family": "MesloLGS NF",
    "dock": "right"
  },
  "gutter": {
    "breakpoints": false,
    "folds": true,
    "line_numbers": true,
    "runnables": true
  },
  "search": {
    "case_sensitive": true,
    "regex": true,
  },
  "agent": {
    "auto_compact": {
      "threshold": "70%"
    },
    "show_turn_stats": true,
    "message_editor_min_lines": 6,
    "play_sound_when_agent_done": "when_hidden",
    "notify_when_agent_waiting": "all_screens",
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "always_allow": [
            {
              "pattern": "^*/wayfinder/"
            }
          ]
        },
        "skill": {
          "default": "allow"
        },
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cargo\\s+check(\\s|$)"
            },
            {
              "pattern": "^ls\\b"
            },
            {
              "pattern": "^pwd\\b"
            },
            {
              "pattern": "^cargo\\s+tarpaulin(\\s|$)"
            },
            {
              "pattern": "^RUSTC_WRAPPER=\\s+cargo\\s+tarpaulin(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+test(\\s|$)"
            },
            {
              "pattern": "^git\\s+status(\\s|$)"
            },
            {
              "pattern": "^CARGO_TARGET_DIR=/tmp/target\\s+RUSTC_WRAPPER=\\s+cargo\\s+test(\\s|$)"
            }
          ]
        }
      }
    },
    "profiles": {
      "write": {
        "default_model": {
          "provider": "ollama",
          "model": "gemma4-65k:latest",
          "enable_thinking": true
        },
        "name": "Write",
        "tools": {
          "edit_file": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      },
      "research": {
        "default_model": {
          "provider": "ollama",
          "model": "gemma4-65k:latest",
          "enable_thinking": true
        },
        "name": "Research",
        "tools": {
          "grep": true,
          "copy_path": true,
          "diagnostics": true,
          "move_path": true,
          "edit_file": true,
          "create_directory": true,
          "fetch": true,
          "find_path": true,
          "read_file": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": false,
          "write_file": true,
          "list_directory": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-sequential-thinking": {
            "tools": {
              "sequentialthinking": true
            }
          }
        }
      }
    },
    "default_profile": "write",
    "dock": "left",
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "gemma4-65k:latest",
      "enable_thinking": false
    },
    "default_model": {
      "enable_thinking": true,
      "provider": "ollama",
      "model": "gemma4-65k:latest"
    },
  },
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Tokyo Night Moon"
  },
  "format_on_save": "off",
  "pane_split_direction_vertical": "right",
  "pane_split_direction_horizontal": "down",
  "vim": {
    "gdefault": true,
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "use_regex_search": true,
    "use_system_clipboard": "on_yank",
  },
  "lsp": {
    "pylsp": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "never"
          }
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "never"
          }
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "tab_size": 2
    },
    "TypeScript": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    }
  }
