  "context_servers": {
    "github-activity-summarizer": {
      "enabled": true,
      "remote": false,
      "settings": {
        "author": "compilersEllie"
      }
    }
  },
  "cli_default_open_behavior": "existing_window",
  "icon_theme": "Colored Zed Icons Theme Dark",
  "buffer_font_family": "MesloLGS NF",
  "ui_font_family": ".ZedSans",
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "title_bar": {
    
  },
  "project_panel": {
    "dock": "left",
    "git_status_indicator": true
  },
  "toolbar": {
    "code_actions": true,
    "selections_menu": true,
    "quick_actions": true
  },
  "minimap": {
    "show": "never"
  },
  "tabs": {
    "show_close_button": "hidden",
    "activate_on_close": "left_neighbour"
  },
  "agent_servers": {
    "goose": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    },
    "corust-agent": {
      "type": "registry"
    }
  },
  "show_edit_predictions": true,
  "use_autoclose": false,
  "edit_predictions": {
    "provider": "ollama",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
  },
  "vim_mode": true,
  "ui_font_size": 14.0,
  "buffer_font_size": 11.0,
  "terminal": {
    "font_family": "MesloLGS NF",
    "dock": "right"
  },
  "gutter": {
    "breakpoints": false,
    "folds": true,
    "line_numbers": true,
    "runnables": true
  },
  "search": {
    "case_sensitive": true,
    "regex": true,
  },
  "agent": {
    "profiles": {
      "write": {
        "default_model": {
          "provider": "ollama",
          "model": "qwen3-coder:30b",
          "enable_thinking": false
        },
        "name": "Write",
        "tools": {
          "edit_file": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      },
      "research": {
        "default_model": {
          "provider": "ollama",
          "model": "gemma4:31b",
          "enable_thinking": true
        },
        "name": "Research",
        "tools": {
          "grep": true,
          "copy_path": true,
          "diagnostics": true,
          "move_path": true,
          "edit_file": true,
          "create_directory": true,
          "fetch": true,
          "find_path": true,
          "read_file": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": false,
          "write_file": true,
          "list_directory": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "mcp-server-sequential-thinking": {
            "tools": {
              "sequentialthinking": true
            }
          }
        }
      }
    },
    "default_profile": "research",
    "dock": "right",
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "gemma4:latest",
      "enable_thinking": false
    },
    "default_model": {
      "enable_thinking": true,
      "provider": "ollama",
      "model": "qwen3.5:35b"
    },
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "format_on_save": "off",
  "pane_split_direction_vertical": "right",
  "pane_split_direction_horizontal": "down",
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
  },
  "lsp": {
    "pylsp": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "never"
          }
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "never"
          }
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "tab_size": 2
    },
    "TypeScript": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    }
  }
}
