  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "title_bar": {
    "show_branch_icon": false
  },
  "project_panel": {
    "dock": "right",
    "git_status_indicator": true
  },
  "toolbar": {
    "code_actions": true,
    "selections_menu": true,
    "quick_actions": true
  },
  "minimap": {
    "show": "never"
  },
  "tabs": {
    "show_close_button": "hidden",
    "activate_on_close": "left_neighbour"
  },
  "agent_servers": {
    "goose": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    },
    "corust-agent": {
      "type": "registry"
    }
  },
  "show_edit_predictions": false,
  "use_autoclose": false,
  "edit_predictions": {
    "provider": "ollama",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "terminal": {
    "dock": "right"
  },
  "gutter": {
    "breakpoints": false,
    "folds": true,
    "line_numbers": true,
    "runnables": true
  },
  "search": {
    "case_sensitive": true,
    "regex": true,
  },
  "agent": {
    "dock": "left",
    "inline_assistant_model": {
      "provider": "ollama",
      "model": "gemma4:latest",
      "enable_thinking": false
    },
    "default_model": {
      "enable_thinking": true,
      "provider": "ollama",
      "model": "nemotron-cascade-2:latest"
    },
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "format_on_save": "off",
  "pane_split_direction_vertical": "right",
  "pane_split_direction_horizontal": "down",
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
  },
  "lsp": {
    "pylsp": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "never"
          }
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "never"
          }
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "tab_size": 2
    },
    "TypeScript": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    }
  }
}
